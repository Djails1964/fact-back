<?php
/**
 * cors_middleware.php - Version debug améliorée
 */

function handle_cors() {
    global $config;
    
    // En-têtes pour le cache
    header("Cache-Control: no-store, no-cache, must-revalidate, max-age=0");
    header("Cache-Control: post-check=0, pre-check=0", false);
    header("Pragma: no-cache");
    
    $isDevelopment = is_dev_mode();
    $origin = $_SERVER['HTTP_ORIGIN'] ?? '';
    $allowedOrigins = explode(',', env('CORS_ORIGIN', ''));
    
    // DEBUG - AJOUTER CES LOGS
    error_log("🔥 CORS DEBUG - Origin reçu: " . $origin);
    error_log("🔥 CORS DEBUG - Origines autorisées: " . json_encode($allowedOrigins));
    error_log("🔥 CORS DEBUG - Mode développement: " . ($isDevelopment ? 'Oui' : 'Non'));
    error_log("🔥 CORS DEBUG - Méthode: " . $_SERVER['REQUEST_METHOD']);
    
    function isAllowedOrigin($origin, $allowedOrigins, $isDevelopment) {
        // Nettoyer les espaces dans les origines autorisées
        $allowedOrigins = array_map('trim', $allowedOrigins);
        
        error_log("🔥 CORS DEBUG - Origines nettoyées: " . json_encode($allowedOrigins));
        
        // Vérification directe
        if (in_array($origin, $allowedOrigins)) {
            error_log("🔥 CORS DEBUG - Origin trouvé dans la liste autorisée");
            return true;
        }
        
        // En développement, règles plus souples
        if ($isDevelopment) {
            if (preg_match('/^https?:\/\/localhost(:[0-9]+)?$/', $origin)) {
                error_log("🔥 CORS DEBUG - Origin localhost autorisé en dev");
                return true;
            }
            
            $host = parse_url($origin, PHP_URL_HOST);
            if ($host) {
                $ip = gethostbyname($host);
                if (filter_var($ip, FILTER_VALIDATE_IP) && (
                    preg_match('/^10\./', $ip) ||
                    preg_match('/^172\.(1[6-9]|2[0-9]|3[0-1])\./', $ip) ||
                    preg_match('/^192\.168\./', $ip) ||
                    $ip === '127.0.0.1'
                )) {
                    error_log("🔥 CORS DEBUG - IP réseau privé autorisé: " . $ip);
                    return true;
                }
            }
        }
        
        error_log("🔥 CORS DEBUG - Origin NON autorisé");
        return false;
    }
    
    // Vérifier l'origine
    if ($origin && isAllowedOrigin($origin, $allowedOrigins, $isDevelopment)) {
        error_log("🔥 CORS DEBUG - ✅ Origin autorisé, envoi des headers");
        
        header("Access-Control-Allow-Origin: $origin");
        header('Access-Control-Allow-Credentials: true');
        
        if ($isDevelopment) {
            header('Access-Control-Allow-Methods: ' . env('CORS_METHODS', 'GET, POST, PUT, DELETE, OPTIONS'));
            header('Access-Control-Allow-Headers: ' . env('CORS_HEADERS', 'Content-Type, Authorization, X-Requested-With'));
        } else {
            header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
            header('Access-Control-Allow-Headers: Content-Type, Authorization');
            header('Access-Control-Max-Age: 86400');
        }
        
        if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
            error_log("🔥 CORS DEBUG - Requête OPTIONS, arrêt après headers");
            header('Content-Type: application/json');
            http_response_code(200);
            echo json_encode(['status' => 'preflight_ok']);
            return false;
        }
        
        return true;
    } else if ($origin) {
        error_log("🔥 CORS DEBUG - ❌ Origin non autorisé: $origin");
        header('Content-Type: application/json');
        http_response_code(403);
        echo json_encode([
            'success' => false,
            'message' => 'Origine non autorisée',
            'origin' => $origin,
            'allowed' => $allowedOrigins,
            'debug' => $isDevelopment
        ]);
        return false;
    }
    
    error_log("🔥 CORS DEBUG - Pas d'origin, continuation normale");
    return true;
}
?>