<?php
/**
 * auth-api.php - API pour la gestion des utilisateurs
 * Version refactorisée avec configuration centralisée
 */

// Inclure la configuration centralisée - elle charge déjà Dotenv et les variables d'environnement
$config = require_once realpath(__DIR__ . '/../bootstrap.php');

// Désactiver l'affichage des erreurs/warnings seulement si non en mode développement
if (!is_dev_mode()) {
    ini_set('display_errors', 0);
    error_reporting(E_ERROR); // Rapporter uniquement les erreurs fatales
}

// Définir le chemin du dossier de logs
$logDir = $config['logs']['dir'];

ob_start(); // Start output buffering

// Inclure et exécuter le middleware CORS
require_once realpath(__DIR__ . '/../middleware/cors_middleware.php');
if (!handle_cors()) {
    // Si le middleware renvoie false, arrêter l'exécution
    exit;
}


// Définir le type de contenu pour toutes les réponses
header('Content-Type: application/json');

// Inclure les dépendances nécessaires
require_once 'database.php';
require_once realpath(__DIR__ . '/../ServiceAuthentification.php');  // Service authentification

try {
    // Créer l'instance du service
    $serviceAuth = new ServiceAuthentification($conn);
    
    $method = $_SERVER['REQUEST_METHOD'];
    $resultat = null;
    
    switch ($method) {
        case 'GET':
            if (isset($_GET['utilisateurs'])) {
                // Récupérer tous les utilisateurs (réservé aux administrateurs)
                // TODO: Vérifier les droits d'administration
                $resultat = $serviceAuth->getUtilisateurs();
            } 
            else if (isset($_GET['utilisateur'])) {
                // Récupérer un utilisateur par son ID
                if (!isset($_GET['id'])) {
                    throw new Exception('ID de l\'utilisateur requis');
                }
                
                $id = intval($_GET['id']);
                $resultat = $serviceAuth->getUtilisateurParId($id);
            }
            else {
                throw new Exception('Paramètres de requête insuffisants ou incorrects');
            }
            break;
            
        case 'POST':
            // Lire les données brutes du corps de la requête
            $rawData = file_get_contents("php://input");
            
            // Décoder les données JSON
            $data = json_decode($rawData, true);
            
            // Vérifier si le décodage JSON a réussi
            if ($data === null && json_last_error() !== JSON_ERROR_NONE) {
                throw new Exception('Données JSON invalides');
            }
            
            // Vérifier si des données ont été reçues
            if (!$data) {
                throw new Exception('Aucune donnée reçue');
            }
            
            // Traiter les différentes actions
            if (isset($data['action'])) {
                switch ($data['action']) {
                    case 'login':
                        // Authentification
                        if (!isset($data['username']) || !isset($data['password'])) {
                            throw new Exception('Nom d\'utilisateur et mot de passe requis');
                        }
                        
                        $resultat = $serviceAuth->authentifier($data['username'], $data['password']);
                        break;
                        
                    case 'createUser':
                        // Création d'un utilisateur
                        $resultat = $serviceAuth->creerUtilisateur($data);
                        break;
                        
                    case 'changePassword':
                        // Changement de mot de passe
                        if (!isset($data['id']) || !isset($data['oldPassword']) || !isset($data['newPassword'])) {
                            throw new Exception('ID utilisateur, ancien et nouveau mot de passe requis');
                        }
                        
                        $resultat = $serviceAuth->changerMotDePasse($data['id'], $data['oldPassword'], $data['newPassword']);
                        break;
                        
                    case 'resetPassword':
                        // Réinitialisation de mot de passe (par admin)
                        if (!isset($data['id']) || !isset($data['newPassword'])) {
                            throw new Exception('ID utilisateur et nouveau mot de passe requis');
                        }
                        
                        $resultat = $serviceAuth->reinitialiserMotDePasse($data['id'], $data['newPassword']);
                        break;
                        
                    default:
                        throw new Exception('Action non reconnue');
                }
            } else {
                throw new Exception('Action non spécifiée');
            }
            break;
            
        case 'PUT':
            $data = json_decode(file_get_contents("php://input"), true);
            if (!$data || !isset($data['id'])) {
                throw new Exception('Données JSON invalides ou incomplètes');
            }
            
            // Mise à jour d'un utilisateur
            $resultat = $serviceAuth->modifierUtilisateur($data['id'], $data);
            break;
            
        case 'DELETE':
            if (isset($_GET['id'])) {
                $id = intval($_GET['id']);
                $resultat = $serviceAuth->supprimerUtilisateur($id);
            } else {
                throw new Exception('ID de l\'utilisateur requis pour la suppression');
            }
            break;
            
        default:
            throw new Exception('Méthode HTTP non supportée');
    }
    
    // Un seul point d'encodage JSON pour toutes les méthodes
    echo json_encode($resultat);
    
} catch (Exception $e) {
    // Journaliser l'erreur
    error_log('Erreur API Auth: ' . $e->getMessage());
    
    http_response_code(400);
    echo json_encode([
        'success' => false, 
        'message' => $e->getMessage()
    ]);
}
?>