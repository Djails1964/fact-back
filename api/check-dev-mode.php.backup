<?php
/**
 * api/check-dev-mode.php
 * 
 * Endpoint pour vérifier si l'application est en mode développement
 * Utilisé par le frontend pour afficher les options de développement
 */

// Inclure le bootstrap pour accéder aux configurations
require_once '../bootstrap.php';

// Définir les en-têtes pour JSON
header('Content-Type: application/json');
header('Cache-Control: no-cache, must-revalidate');

// CORS si nécessaire
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET');
header('Access-Control-Allow-Headers: Content-Type');

try {
    // Vérifier la méthode HTTP
    if ($_SERVER['REQUEST_METHOD'] !== 'GET') {
        throw new Exception('Méthode non autorisée');
    }
    
    // Vérifier si on est en mode développement
    $isDevelopment = is_dev_mode();
    
    // Informations supplémentaires en mode développement
    $debugInfo = [];
    if ($isDevelopment) {
        $debugInfo = [
            'app_env' => env('APP_ENV'),
            'mail_send_mode' => env('MAIL_SEND_MODE', 'direct'),
            'session_id' => session_id(),
            'timestamp' => date('Y-m-d H:i:s')
        ];
    }
    
    // Retourner la réponse
    $response = [
        'success' => true,
        'isDevelopment' => $isDevelopment,
        'debug' => $debugInfo
    ];
    
    echo json_encode($response, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);
    
} catch (Exception $e) {
    // Log de l'erreur
    error_log("Erreur check-dev-mode.php: " . $e->getMessage());
    
    // Retourner l'erreur
    http_response_code(400);
    echo json_encode([
        'success' => false,
        'isDevelopment' => false,
        'message' => $e->getMessage()
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);
}
?>