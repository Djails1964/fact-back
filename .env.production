# .env - Configuration Backend PHP PRODUCTION
# Emplacement : /volume1/web/facturation/api/.env

# ==========================================
# ENVIRONNEMENT
# ==========================================
APP_ENV=production
APP_NAME="Facturation"
APP_VERSION=7.0.0
APP_COPYRIGHT="© 2025 Centre La Grange. Tous droits réservés."

# URLs - Architecture proxy (même domaine)
APP_URL_FRONT=https://facturation
APP_URL_BACK=https://facturation/api

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=https://facturation
CORS_METHODS="GET, POST, PUT, DELETE, OPTIONS"
CORS_HEADERS="Content-Type, Authorization, X-Requested-With"
CORS_CREDENTIALS=true

# ==========================================
# BASE DE DONNÉES PRÉ-PRODUCTION
# ==========================================
DB_HOST=localhost
DB_USER=root
DB_PASS=6ZQHsCp6%q883R
DB_NAME=facturation_prod

# ==========================================
# SESSION
# ==========================================
SESSION_LIFETIME=1800
TIMEZONE=Europe/Zurich

# ==========================================
# LOGS (minimal en production)
# ==========================================
LOG_DIR=logs
LOG_LEVEL=error

# ==========================================
# EMAILS
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=thoutmosis.iv@gmail.com
MAIL_PASSWORD="dbea qagb vmzv jtll"
MAIL_ENCRYPTION=tls
MAIL_FROM=thoutmosis.iv@gmail.com
MAIL_REPLY_TO=contact@lagrange.ch
ABSOLUTE_EMAIL_LOG_PATH=/volume1/web/pp-facturation/api/logs/emails
MAIL_SEND_MODE=client

ENABLE_PASSWORD_RESET=true

# ==========================================
# INDICATEUR ENVIRONNEMENT (pour l'UI)
# ==========================================
ENVIRONMENT_LABEL=PRODUCTION
ENVIRONMENT_COLOR=#4caf50
